#!/usr/bin/env bash
set -Eeuo pipefail

# Resolve symlinks so restic-cli works when invoked from /usr/local/bin.
ROOT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
LIB_DIR="${ROOT_DIR}/lib"

# shellcheck disable=SC1091
source "${LIB_DIR}/common.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/setup.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/backup.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/restore.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/manage.sh"
# shellcheck disable=SC1091
source "${LIB_DIR}/scheduler.sh"

# Print CLI usage.
print_usage() {
  cat <<'EOF'
restic-cli - centralized Restic backup controller

Usage:
  restic-cli init
  restic-cli setup
  restic-cli servers
  restic-cli remove <server_name>
  restic-cli backup [server_name]
  restic-cli run-due
  restic-cli logs [server_name] [count]
  restic-cli snapshots [server_name]
  restic-cli diff <server_name> <snapshot_a> <snapshot_b>
  restic-cli prune <server_name>
  restic-cli restore [server_name] [snapshot_id] [--no-push|--push]
  restic-cli restore [server_name] [--no-push|--push]

Commands:
  init     Interactive global configuration wizard
  setup    Interactive server configuration wizard
  servers  List configured servers included in backup runs
  remove   Remove server from backup list (keeps repository data)
  backup   Run backups for all configured servers or one server
  run-due  Run backups only for servers whose configured frequency is due
  logs     Show recent operation logs, optionally filtered by server
  snapshots  Show snapshots for one server or all servers
  diff     Compare two snapshots for one configured server
  prune    Remove older snapshots whose data tree is identical to a newer snapshot
  restore  Restore latest or specific snapshot, optionally in no-push preview mode
EOF
}

# Validate top-level command input.
validate_command() {
  local cmd="${1:-}"
  case "${cmd}" in
    init|setup|servers|remove|backup|run-due|logs|snapshots|diff|prune|restore)
      return 0
      ;;
    ""|-h|--help)
      print_usage
      exit 0
      ;;
    *)
      msg_error "Unknown command: ${cmd}"
      print_usage
      exit 2
      ;;
  esac
}

# Dispatch command to implementation modules.
main() {
  ensure_project_directories

  local command="${1:-}"
  local target="${2:-}"
  local extra="${3:-}"
  local extra2="${4:-}"
  local extra3="${5:-}"

  validate_command "${command}"

  case "${command}" in
    init)
      if [[ -n "${target}" ]]; then
        die "init does not accept extra arguments."
      fi
      run_init_wizard
      ;;
    setup)
      if [[ -n "${target}" ]]; then
        die "setup does not accept extra arguments."
      fi
      run_setup_wizard
      ;;
    servers)
      if [[ -n "${target}" ]]; then
        die "servers does not accept extra arguments."
      fi
      run_servers
      ;;
    remove)
      [[ -n "${target}" ]] || die "remove requires server_name."
      if [[ -n "${extra}" ]]; then
        die "remove accepts only one server_name argument."
      fi
      run_remove_server "${target}"
      ;;
    backup)
      if [[ -n "${extra}" ]]; then
        die "backup accepts at most one server_name argument."
      fi
      run_backup "${target}"
      ;;
    run-due)
      if [[ -n "${target}" ]]; then
        die "run-due does not accept extra arguments."
      fi
      run_due_backups
      ;;
    logs)
      if [[ -n "${extra2}" || -n "${extra3}" ]]; then
        die "logs accepts at most two optional arguments: [server_name] [count]."
      fi
      run_logs "${target}" "${extra}"
      ;;
    snapshots)
      if [[ -n "${extra}" ]]; then
        die "snapshots accepts at most one server_name argument."
      fi
      run_snapshots "${target}"
      ;;
    diff)
      [[ -n "${target}" ]] || die "diff requires server_name."
      [[ -n "${extra}" ]] || die "diff requires snapshot_a."
      [[ -n "${extra2}" ]] || die "diff requires snapshot_b."
      if [[ -n "${extra3}" ]]; then
        die "diff accepts exactly three arguments: <server_name> <snapshot_a> <snapshot_b>."
      fi
      run_snapshot_diff "${target}" "${extra}" "${extra2}"
      ;;
    prune)
      [[ -n "${target}" ]] || die "prune requires server_name."
      if [[ -n "${extra}" ]]; then
        die "prune accepts exactly one server_name argument."
      fi
      run_prune_identical_snapshots "${target}"
      ;;
    restore)
      local snapshot_arg=""
      local no_push_arg="yes"
      local restore_flag=""

      if [[ -n "${extra2}" && "${extra2}" != "--no-push" && "${extra2}" != "--push" ]]; then
        die "restore only accepts optional --no-push or --push as the final argument."
      fi

      if [[ "${extra}" == "--no-push" || "${extra}" == "--push" ]]; then
        snapshot_arg="latest"
        restore_flag="${extra}"
      elif [[ -n "${extra}" ]]; then
        snapshot_arg="${extra}"
        restore_flag="${extra2}"
      elif [[ -n "${extra2}" ]]; then
        die "restore argument order invalid. Use: restore [server] [snapshot] [--no-push|--push]"
      fi

      if [[ "${restore_flag}" == "--push" ]]; then
        no_push_arg="no"
      fi

      run_restore "${target}" "${snapshot_arg}" "${no_push_arg}"
      ;;
    *)
      die "Internal error: command dispatcher reached unexpected path."
      ;;
  esac
}

main "$@"
