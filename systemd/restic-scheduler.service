[Unit]
Description=restic-scheduler backup frequency runner
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# install.sh rewrites ExecStart and WorkingDirectory to this checkout root.
ExecStart=/opt/restic_backup/restic-cli run-due
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
